# Python cache
__pycache__/
*.py[cod]
*$py.class

# ML model files — large ones excluded, small ones tracked
models/rf.joblib
*.pkl
*.h5
# Allow the small model files explicitly
!models/pca.joblib
!models/knn.joblib
!models/mlp.joblib
!models/svm.joblib
!models/classes.joblib

# Large dataset directory (54,000 images - too large for GitHub free tier)
dataset/
/images/
static/captures/*
!static/captures/.gitkeep

# Virtual environments
venv/
.venv/
env/

# IDE / OS metadata
.idea/
.vscode/
Thumbs.db
.DS_Store

# Generated test outputs & scratch files
test_output.pdf
scratch_inspect.py
